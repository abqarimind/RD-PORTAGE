# ——— Emailing transactionnel Resend (docs : rapport-maintenance.md §5) ———
# Clé API serveur — JAMAIS exposée au navigateur, jamais en dur dans le code.
# Sans clé, les envois passent en mode simulé : le parcours reste testable de
# bout en bout et chaque envoi est tracé dans les logs.
RESEND_API_KEY=
# Stockage des contacts dans Resend (CRM_PROVIDER=resend).
# Les « Audiences » sont devenues des Segments : les contacts sont globaux au
# compte, le segment ne sert qu'à les ranger. Optionnel.
RESEND_SEGMENT_LEADS_ID=
# Nom de l'événement qui déclenche l'Automation de la séquence J0→J14.
# Une Automation Resend se déclenche sur un événement nommé, pas sur l'entrée
# dans une liste. Optionnel, défaut « sequence_j14 ».
RESEND_SEQUENCE_EVENT=

# Expéditeur. Tant que le domaine rdportage.com n'est pas vérifié chez Resend
# (enregistrements DNS à faire poser — voir rapport-maintenance.md §4),
# laisser l'expéditeur de repli ci-dessous. La bascule se fait en changeant
# cette seule variable.
#   repli (fonctionne immédiatement) : RD Portage <onboarding@resend.dev>
#   cible (après vérification DNS)   : RD Portage <simulateur@rdportage.com>
#
# IMPORTANT — MAIL_FROM et MAIL_INTERNAL_TO doivent être des adresses
# DIFFÉRENTES. Envoyer depuis marketing@ vers marketing@ produit des
# comportements de filtrage erratiques chez la plupart des clients mail
# (auto-expédition classée en promotion, en spam, ou repliée dans le fil).
# Configuration recommandée : expédier depuis simulateur@rdportage.com (ou
# no-reply@), recevoir les copies sur marketing@rdportage.com.
#
# Décision client D5 (24/09) : les emails au prospect partent de marketing@,
# et « Répondre » écrit toujours à l'entreprise. Configuration de production :
#   MAIL_FROM=RD Portage <marketing@rdportage.com>
#   MAIL_REPLY_TO=marketing@rdportage.com
#   MAIL_FROM_INTERNE=Simulateur RD Portage <simulateur@rdportage.com>
#   MAIL_INTERNAL_TO=marketing@rdportage.com
MAIL_FROM=

# Adresse qui reçoit les réponses des prospects (en-tête Reply-To).
# Défaut dans le code : marketing@rdportage.com.
MAIL_REPLY_TO=

# Expéditeur des copies internes E2/E4. Obligatoire dès que MAIL_FROM vaut
# marketing@ : il doit différer de MAIL_INTERNAL_TO. Défaut : MAIL_FROM.
MAIL_FROM_INTERNE=

# Destinataires de la notification « Nouveau lead simulateur » (une par
# lead) et de E4 (demande de diagnostic). Liste séparée par des virgules,
# ex. « marketing@rdportage.com,ridha@…,ayoub@… ». Doit différer de
# l'expéditeur interne — voir ci-dessus.
MAIL_INTERNAL_TO=marketing@rdportage.com

# Secret de signature des liens de dossier (/dossier?d=…&s=…).
# BLOQUANT en production : sans lui, les routes d'email et de dossier lèvent
# une erreur explicite au lieu de produire des liens forgeables.
# Générer avec : openssl rand -hex 32
DOSSIER_SECRET=

# URL publique du site, utilisée pour construire les liens des emails et le
# domaine affiché dans les mentions. À défaut, elle est déduite des en-têtes
# de la requête. À poser dans Vercel une fois le domaine raccordé :
#   NEXT_PUBLIC_SITE_URL=https://simulateur.rdportage.com
NEXT_PUBLIC_SITE_URL=https://simulateur.rdportage.com

# ——— CRM (docs/branchement-brevo-airtable.md) ———
# mock | brevo | airtable | google-sheet | custom
#
# ATTENTION : `mock` ne conserve RIEN en production (Map en mémoire + système
# de fichiers éphémère sur Vercel). Le code journalise une erreur explicite
# au démarrage dans ce cas, et les emails internes portent une alerte avec
# les données brutes du lead. En production : airtable (ou brevo).
CRM_PROVIDER=mock
BREVO_API_KEY=
BREVO_SEQ14_LIST_ID=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# AIRTABLE_LEADS_TABLE=Leads
# AIRTABLE_EVENTS_TABLE=Events

# ——— Export CSV transition (workflow Linda) ———
EXPORT_TOKEN=

# ——— Mesure d'audience sans cookie (docs/mesure-sans-cookie.md) ———
# Active d'office sur la PRODUCTION Vercel, avec le script du site
# (https://plausible.io/js/pa-Um3XuVPoX76PZHXQpHXCw.js). Coupée en Preview.
# Facultatif : autre script Plausible.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT=
# « true » active la mesure hors production (Preview de test, local, CI).
NEXT_PUBLIC_PLAUSIBLE_DEBUG=
NEXT_PUBLIC_GA4_ENABLED=false

# ——— Meta (Facebook/Instagram) — docs/meta-pixel.md, docs/meta-capi.md ———
# Pixel navigateur (public). Défaut dans le code : 4019768748330072
# (« RD Portage - Pixel simulateur »). « off » le coupe partout.
# Actif uniquement sur le déploiement de PRODUCTION Vercel (VERCEL_ENV) :
# coupé en Preview et en local, bannière comprise.
NEXT_PUBLIC_META_PIXEL_ID=
# « true » active le Pixel et la bannière hors production (Preview de test
# avec « Tester les événements », local, CI).
NEXT_PUBLIC_META_PIXEL_DEBUG=

# API Conversions serveur — PRÉPARÉE, NON ACTIVÉE (docs/meta-capi.md).
# Rien ne part tant que META_CAPI_ENABLED n'est pas exactement « true ».
META_CAPI_ENABLED=false
# Token serveur (secret — jamais exposé au navigateur, jamais dans le dépôt),
# généré dans le Gestionnaire d'événements. À poser dans Vercel uniquement.
META_CAPI_TOKEN=
# Facultatif : surcharge serveur du Pixel ID (défaut = NEXT_PUBLIC_META_PIXEL_ID)
# META_PIXEL_ID=
# Facultatif : version de la Graph API (défaut v19.0)
# META_GRAPH_VERSION=v19.0
# Facultatif : code « Tester les événements » pour la CAPI
# META_CAPI_TEST_EVENT_CODE=

# ——— Comparatif nominatif (docs/activation-comparatif.md) ———
COMPARATIF_LEGAL_VALIDATED=false

# ——— WhatsApp Business (retour #16) ———
# Lien d'ouverture de conversation, ex. https://wa.me/33612345678
# Vide = l'option WhatsApp reste masquée sous « Nous contacter ».
NEXT_PUBLIC_WHATSAPP_URL=

# ——— Prise de RDV Diagnostic 30 min ———
# Défaut dans le code : tel:+33171497157 (ligne de l'équipe, config/contact.ts).
# Renseigner un lien Calendly ici quand il existera.
NEXT_PUBLIC_RDV_URL=

# ——— VSL (variante /lp/<angle>?v=vsl) ———
# URL d'embed de la vidéo VSL (YouTube/Vimeo/MP4 hébergé). Vide = placeholder.
NEXT_PUBLIC_VSL_URL=

# ——— Rapport hebdo ———
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=noreply@rdportage.com

# ——— Journal NDJSON (zéro perte) ———
# Défaut : ./data en local, /tmp/rdp-journal sur Vercel (seul dossier inscriptible).
# JOURNAL_DIR=/data

# ——— Anti-spam du formulaire ———
# Envois par IP et par tranche de 10 minutes (défaut 5). Ne sert qu'aux tests.
# LEAD_RATE_LIMIT_MAX=
