# ——— Emailing transactionnel Resend (docs : rapport-maintenance.md §5) ———
# Clé API serveur — JAMAIS exposée au navigateur, jamais en dur dans le code.
# Sans clé, les envois passent en mode simulé : le parcours reste testable de
# bout en bout et chaque envoi est tracé dans les logs.
RESEND_API_KEY=

# Expéditeur. Tant que le domaine rdportage.com n'est pas vérifié chez Resend
# (enregistrements DNS à faire poser — voir rapport-maintenance.md §5.5),
# laisser l'expéditeur de repli ci-dessous. La bascule se fait en changeant
# cette seule variable.
#   repli (fonctionne immédiatement) : RD Portage <onboarding@resend.dev>
#   cible (après vérification DNS)   : RD Portage <marketing@rdportage.com>
MAIL_FROM=

# Destinataire des copies internes E2 (récapitulatif) et E4 (nouveau lead).
MAIL_INTERNAL_TO=marketing@rdportage.com

# Secret de signature des liens de dossier (/dossier?d=…&s=…).
# OBLIGATOIRE en production : sans lui, les liens ne sont pas signés de façon
# sûre. Générer avec : openssl rand -hex 32
DOSSIER_SECRET=

# URL publique du site, utilisée pour construire les liens des emails.
# À défaut, elle est déduite des en-têtes de la requête.
NEXT_PUBLIC_SITE_URL=https://rd-portage.vercel.app

# ——— CRM (docs/branchement-brevo-airtable.md) ———
# mock | brevo | airtable | google-sheet | custom
CRM_PROVIDER=mock
BREVO_API_KEY=
BREVO_SEQ14_LIST_ID=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# AIRTABLE_LEADS_TABLE=Leads
# AIRTABLE_EVENTS_TABLE=Events

# ——— Export CSV transition (workflow Linda) ———
EXPORT_TOKEN=

# ——— Tracking ———
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ENABLED=false

# ——— Meta (Facebook/Instagram) Pixel + Conversions API ———
# docs/landing-conversion.md. Tout reste en mode mock si vide : aucun event
# Meta n'est envoyé, aucune bannière de consentement ne s'affiche.
# Pixel navigateur (public) :
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API serveur (secret — jamais exposé au navigateur) :
META_CAPI_ACCESS_TOKEN=
# Facultatif : surcharge serveur du Pixel ID (défaut = NEXT_PUBLIC_META_PIXEL_ID)
# META_PIXEL_ID=
# Facultatif : version de la Graph API (défaut v19.0)
# META_GRAPH_VERSION=v19.0
# Facultatif : code « Test des événements » (Events Manager) pour vérifier la CAPI
# META_CAPI_TEST_EVENT_CODE=

# ——— Comparatif nominatif (docs/activation-comparatif.md) ———
COMPARATIF_LEGAL_VALIDATED=false

# ——— Prise de RDV Diagnostic 30 min ———
# Défaut dans le code : tel:+33632988723 (appel direct Ridha).
# Renseigner un lien Calendly ici quand il existera.
NEXT_PUBLIC_RDV_URL=

# ——— VSL (variante /lp/<angle>?v=vsl) ———
# URL d'embed de la vidéo VSL (YouTube/Vimeo/MP4 hébergé). Vide = placeholder.
NEXT_PUBLIC_VSL_URL=

# ——— Rapport hebdo ———
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=noreply@rdportage.com

# ——— Journal NDJSON (zéro perte) ———
# JOURNAL_DIR=/data
